{
  "name": "high-scale-ecommerce-engine",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx test/**/*.test.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "bullmq": "^5.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.1",
    "express": "^4.21.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.0.1",
    "opossum": "^8.2.0",
    "pg": "^8.12.0",
    "pino": "^9.1.0",
    "prom-client": "^15.1.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "@types/swagger-jsdoc": "^6.0.0",
    "@types/swagger-ui-express": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
